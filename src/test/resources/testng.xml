<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GitHub Repositories API Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.github.api.reporting.TextReportListener"/>
    </listeners>
    <test name="GitHub Repositories Tests">
        <classes>
            <class name="com.github.api.tests.GetRepoTests"/>
            <class name="com.github.api.tests.ListReposTests"/>
            <class name="com.github.api.tests.CreateRepoTests"/>
            <class name="com.github.api.tests.UpdateRepoTests"/>
            <class name="com.github.api.tests.DeleteRepoTests"/>
            <class name="com.github.api.tests.EndToEndRepoLifecycleTest"/>
        </classes>
    </test>
</suite>
