{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub Repository",
  "type": "object",
  "required": [
    "id",
    "node_id",
    "name",
    "full_name",
    "private",
    "owner",
    "html_url",
    "fork",
    "url"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "node_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "private": {
      "type": "boolean"
    },
    "owner": {
      "type": "object",
      "required": ["login", "id", "node_id", "avatar_url", "url", "html_url", "type"],
      "properties": {
        "login": { "type": "string" },
        "id": { "type": "integer" },
        "node_id": { "type": "string" },
        "avatar_url": { "type": "string" },
        "url": { "type": "string" },
        "html_url": { "type": "string" },
        "type": { "type": "string" },
        "site_admin": { "type": "boolean" }
      }
    },
    "html_url": {
      "type": "string"
    },
    "description": {
      "type": ["string", "null"]
    },
    "fork": {
      "type": "boolean"
    },
    "url": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "pushed_at": {
      "type": ["string", "null"]
    },
    "git_url": {
      "type": "string"
    },
    "ssh_url": {
      "type": "string"
    },
    "clone_url": {
      "type": "string"
    },
    "svn_url": {
      "type": "string"
    },
    "homepage": {
      "type": ["string", "null"]
    },
    "size": {
      "type": "integer"
    },
    "stargazers_count": {
      "type": "integer"
    },
    "watchers_count": {
      "type": "integer"
    },
    "language": {
      "type": ["string", "null"]
    },
    "has_issues": {
      "type": "boolean"
    },
    "has_projects": {
      "type": "boolean"
    },
    "has_downloads": {
      "type": "boolean"
    },
    "has_wiki": {
      "type": "boolean"
    },
    "has_pages": {
      "type": "boolean"
    },
    "forks_count": {
      "type": "integer"
    },
    "archived": {
      "type": "boolean"
    },
    "disabled": {
      "type": "boolean"
    },
    "open_issues_count": {
      "type": "integer"
    },
    "visibility": {
      "type": "string"
    },
    "default_branch": {
      "type": "string"
    }
  }
}
